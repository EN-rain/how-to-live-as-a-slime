[node name="TitleLabel" type="Label" parent="DeathCard/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.98, 0.36, 0.38, 1)
theme_override_font_sizes/font_size = 28
text = "YOU DIED"
horizontal_alignment = 1

[node name="ReasonLabel" type="Label" parent="DeathCard/VBox"]
layout_mode = 2
