[node name="DeathPanelBackdrop" type="CenterContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0

[node name="DeathCard" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(460, 0)
