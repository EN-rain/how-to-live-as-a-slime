[node name="Sep" type="HSeparator" parent="DeathCard/VBox"]
modulate = Color(1, 0.45, 0.45, 0.35)
layout_mode = 2

[node name="ButtonsRow" type="HBoxContainer" parent="DeathCard/VBox"]
